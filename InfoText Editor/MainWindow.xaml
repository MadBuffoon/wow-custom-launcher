<Window x:Class="HtmlEditorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="HTML Editor" Height="450" Width="800">
    <Grid>
       
        <Grid Margin="0,30,0,0">
            <avalonedit:TextEditor Name="htmlEditor" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10" ShowLineNumbers="True"/>
        </Grid>
        <Grid Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Button Content="Load HTML" Click="OnLoadHtml" Margin="5"/>
                <Button Content="Save HTML" Click="OnSaveHtml" Margin="5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>